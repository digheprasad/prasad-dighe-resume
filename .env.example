# Public GA4 Measurement ID (optional). Analytics loads only after visitor consent.
VITE_GA_MEASUREMENT_ID=

# Optional. If omitted, canonical and structured-data URLs use the live site origin.
VITE_SITE_URL=

# Optional Google Search Console HTML-tag verification token.
VITE_GOOGLE_SITE_VERIFICATION=

# Server-side Netlify function settings. Never use a VITE_ prefix for secrets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
